includes:
    - phpstan.neon
    - vendor/pestphp/pest/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon

services:
    -
        class: Tests\Support\PHPStan\PestClosureThis
        tags:
            - phpstan.functionParameterClosureThisExtension
    -
        class: Tests\Support\PHPStan\PestUsesCallClosureThis
        tags:
            - phpstan.methodParameterClosureThisExtension
    -
        class: Tests\Support\PHPStan\PestTestFunction
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Tests\Support\PHPStan\MigrationMethods
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Tests\Support\PHPStan\PestHigherOrderProperty
        tags:
            - phpstan.broker.expressionTypeResolverExtension
    -
        class: Tests\Support\PHPStan\PestHigherOrderMethod
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Tests\Support\PHPStan\LaravelMagicUsage
        tags:
            - shipmonk.deadCode.memberUsageProvider

parameters:

    # The bleeding-edge include of phpstan.neon turns this on, and it fails every call on Pest's expectation (method.internalClass). A stub cannot do it.
    featureToggles:
        internalTag: false

    stubFiles:
        - phpstan/tests.stub

    universalObjectCratesClasses:
        - Pest\Mixins\Expectation

    # Added to the paths of phpstan.neon (a list in an included file is merged by appending), so the dead-code detector reads the source and the tests together.
    # Reasoned, not run: if the analyser ever overrides a list instead, write the source folders here too.
    paths:
        - tests

    level: 10

    shipmonkDeadCode:
        detect:
            deadEnumCases: false
            deadProperties:
                neverRead: false
